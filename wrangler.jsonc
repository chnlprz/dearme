{
  // Cloudflare Worker: static assets from dist/ plus a small API under /api.
  // Phase 9: passkeys, sync and evening reminders (Web Push). Gentle Help (Claude API) arrives in Phase 10.
  // Served at dearme.innovaspace.app (custom domain).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dearme",
  "main": "worker/index.ts",
  "workers_dev": true,
  "routes": [{ "pattern": "dearme.innovaspace.app", "custom_domain": true }],
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Shared Innova Space accounts live in Nudge!'s D1 database; Dear Me keeps its rows only in its own dm_* tables there.
  "d1_databases": [
    { "binding": "DB", "database_name": "nudge", "database_id": "2a303c20-837b-41ca-a7d1-c759772d1aa4" }
  ],
  // Feedback copies go to this inbox (a verified destination in Email Routing for innovaspace.app, same as Nudge!).
  "send_email": [{ "name": "FEEDBACK_MAIL", "destination_address": "hello.innovaspace@gmail.com" }],
  // Every 5 minutes: send the evening reminder to whoever's chosen time just arrived (in their time zone).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "RP_ID": "innovaspace.app", "FEEDBACK_FROM": "dearme@innovaspace.app", "FEEDBACK_TO": "hello.innovaspace@gmail.com" }
}
